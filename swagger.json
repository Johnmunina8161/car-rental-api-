{
  "openapi": "3.0.0",
  "info": {
    "title": "Car Rental API",
    "version": "1.0.0",
    "description": "Full Car Rental API with JWT authentication and CRUD for Cars, Users, Locations, and Rentals."
  },
  "servers": [
    {
      "url": "https://car-rental-api-wa44.onrender.com/api",
      "description": "Production server (Render)"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentification avec Google" },
    { "name": "Cars", "description": "Gestion du catalogue de voitures" },
    { "name": "Locations", "description": "Gestion des agences" },
    { "name": "Rentals", "description": "Gestion des réservations" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Car": {
        "type": "object",
        "required": ["make", "model", "year", "pricePerDay"],
        "properties": {
          "make": { "type": "string" },
          "model": { "type": "string" },
          "year": { "type": "integer" },
          "pricePerDay": { "type": "number" }
        },
        "example": {
          "make": "Toyota",
          "model": "Corolla",
          "year": 2022,
          "pricePerDay": 50
        }
      },
      "Location": {
        "type": "object",
        "required": ["name", "address", "city", "state"],
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "state": { "type": "string" }
        },
        "example": {
          "name": "Downtown Branch",
          "address": "123 Main St",
          "city": "Los Angeles",
          "state": "CA"
        }
      },
      "Rental": {
        "type": "object",
        "required": ["userId", "carId", "locationId", "startDate", "endDate", "totalPrice"],
        "properties": {
          "userId": { "type": "string" },
          "carId": { "type": "string" },
          "locationId": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "totalPrice": { "type": "number" }
        },
        "example": {
          "userId": "642f8a1234567890abcdef12",
          "carId": "642f8b1234567890abcdef34",
          "locationId": "642f8c1234567890abcdef56",
          "startDate": "2026-03-01",
          "endDate": "2026-03-05",
          "totalPrice": 250
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    }
  },
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Login with Google OAuth",
        "responses": { "302": { "description": "Redirect to Google" } }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth callback",
        "responses": { "200": { "description": "Login successful" } }
      }
    },
    "/cars": {
      "get": {
        "tags": ["Cars"],
        "summary": "Get all cars",
        "responses": { "200": { "description": "Array of cars" } }
      },
      "post": {
        "tags": ["Cars"],
        "summary": "Create a new car",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Car" } } }
        },
        "responses": { "201": { "description": "Car created" } }
      }
    },
    "/cars/{id}": {
      "get": { "tags": ["Cars"], "summary": "Get car by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Details" } } },
      "put": { "tags": ["Cars"], "summary": "Update car", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Car" } } } }, "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Cars"], "summary": "Delete car", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/locations": {
      "get": { "tags": ["Locations"], "summary": "Get all locations", "responses": { "200": { "description": "Array of locations" } } },
      "post": { "tags": ["Locations"], "summary": "Create location", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Location" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/locations/{id}": {
      "get": { "tags": ["Locations"], "summary": "Get location by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Details" } } },
      "put": { "tags": ["Locations"], "summary": "Update location", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Location" } } } }, "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Locations"], "summary": "Delete location", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } }
    },
    "/rentals": {
      "get": { "tags": ["Rentals"], "summary": "Get all rentals", "responses": { "200": { "description": "Array of rentals" } } },
      "post": { "tags": ["Rentals"], "summary": "Create rental", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rental" } } } }, "responses": { "201": { "description": "Created" } } }
    },
    "/rentals/{id}": {
      "get": { "tags": ["Rentals"], "summary": "Get rental by ID", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Details" } } },
      "put": { "tags": ["Rentals"], "summary": "Update rental", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Rental" } } } }, "responses": { "200": { "description": "Updated" } } },
      "delete": { "tags": ["Rentals"], "summary": "Delete rental", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Deleted" } } }
    }
  }
}